diff --git a/build/ci/build-unsigned-ipa.sh b/build/ci/build-unsigned-ipa.sh
new file mode 100644
index 0000000..d561bcd
--- /dev/null
+++ b/build/ci/build-unsigned-ipa.sh
@@ -0,0 +1,40 @@
+#!/bin/bash
+# App packaging stage only; requires the native dependencies from BUILDING.md.
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+cd "$ROOT"
+python3 build/ci/check-app-inputs.py
+[[ "$(uname -s)" == Darwin ]] || { echo 'Xcode on macOS is required.' >&2; exit 2; }
+mkdir -p artifacts
+bash build/stage-licenses.sh
+xcodebuild -project app/Madeira.xcodeproj -scheme Madeira \
+    -configuration Debug -sdk iphoneos -destination 'generic/platform=iOS' \
+    -derivedDataPath "$ROOT/.ci-derived" \
+    CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY= \
+    DEVELOPMENT_TEAM= IPHONEOS_DEPLOYMENT_TARGET=18.5 build \
+    2>&1 | tee artifacts/xcodebuild.log
+APP="$ROOT/.ci-derived/Build/Products/Debug-iphoneos/Madeira.app"
+[[ -f "$APP/Madeira" && -f "$APP/Info.plist" ]] || exit 3
+# Use a fresh staging directory so an earlier failed build cannot leak files.
+STAGE="$(mktemp -d "$ROOT/artifacts/package.XXXXXX")"
+trap 'rm -rf "$STAGE"' EXIT
+mkdir "$STAGE/Payload"
+ditto "$APP" "$STAGE/Payload/Madeira.app"
+# The upstream copy phase ad-hoc signs the converter even with signing disabled.
+# Remove those signatures in the output copy; the sideloader signs the bundle.
+while IFS= read -r -d '' binary; do
+    if codesign -d "$binary" >/dev/null 2>&1; then
+        codesign --remove-signature "$binary"
+    fi
+done < <(find "$STAGE/Payload/Madeira.app" -type f \( -name '*.dylib' -o -name Madeira \) -print0)
+find "$STAGE/Payload" -name _CodeSignature -type d -prune -exec rm -rf {} +
+find "$STAGE/Payload" -name embedded.mobileprovision -type f -delete
+OUTPUT="$ROOT/artifacts/Madeira-iOS18-experimental-unsigned.ipa"
+# zip updates existing archives: remove the old output first to avoid stale entries.
+rm -f "$OUTPUT"
+(cd "$STAGE" && zip -qry "$OUTPUT" Payload)
+unzip -t "$OUTPUT"
+shasum -a 256 "$OUTPUT" > "$OUTPUT.sha256"
+git rev-parse HEAD > artifacts/source-revision.txt
+git diff --binary HEAD > artifacts/local-changes.patch
+echo "Packaged unsigned IPA: $OUTPUT (device validation still required)"
diff --git a/build/ci/check-app-inputs.py b/build/ci/check-app-inputs.py
new file mode 100644
index 0000000..5215913
--- /dev/null
+++ b/build/ci/check-app-inputs.py
@@ -0,0 +1,25 @@
+#!/usr/bin/env python3
+"""Report missing Xcode link inputs before claiming an IPA build is possible."""
+import re
+import sys
+from pathlib import Path
+
+root = Path(__file__).resolve().parents[2]
+project = (root / "app/Madeira.xcodeproj/project.pbxproj").read_text()
+missing = []
+for line in project.splitlines():
+    if "isa = PBXFileReference" not in line or "archive.ar" not in line:
+        continue
+    match = re.search(r'\bpath = (?:"([^"]+)"|([^;]+));', line)
+    if not match:
+        raise RuntimeError(f"Cannot parse library reference: {line}")
+    path = root / "app/Madeira" / (match[1] or match[2])
+    if not path.is_file():
+        missing.append(str(path.resolve().relative_to(root)))
+for item in missing:
+    print(f"MISSING: {item}")
+if missing:
+    print(f"\n{len(missing)} native archives missing. See docs/BUILDING.md and docs/IOS18-JIT.md.")
+    print("This check does not bootstrap dependencies or validate their architecture/source revision.")
+    sys.exit(2)
+print("All Xcode static-library file references exist; compilation/link validation is still required.")
