diff --git a/app/Madeira/JITLegacy.h b/app/Madeira/JITLegacy.h
new file mode 100644
index 0000000..e96fa94
--- /dev/null
+++ b/app/Madeira/JITLegacy.h
@@ -0,0 +1,65 @@
+#ifndef MADEIRA_JIT_LEGACY_H
+#define MADEIRA_JIT_LEGACY_H
+
+/* Included by JITAllocator.c after the Mach declarations and jit_log.
+ * Kept independent of UIKit so the allocation/rollback contract can be tested
+ * with a fake Mach VM on a host. This is the pre-TXM (iOS <26) backend.
+ * The caller must check CS_DEBUGGED; no breakpoint or MAP_JIT is needed here.
+ */
+static void *jit_legacy_prepare_region(void *addr, size_t len) {
+    const size_t mask = JIT_PAGE_SIZE - 1;
+    if (!len || len > SIZE_MAX - mask || ((uintptr_t)addr & mask)) {
+        jit_log("Legacy JIT: invalid address/length");
+        return NULL;
+    }
+    size_t size = (len + mask) & ~mask;
+    if (addr && (uintptr_t)addr > UINTPTR_MAX - size) return NULL;
+    vm_address_t base = (vm_address_t)addr;
+    bool owned = addr == NULL;
+    kern_return_t kr;
+    if (owned) {
+        kr = vm_allocate(mach_task_self(), &base, size, VM_FLAGS_ANYWHERE);
+        if (kr != KERN_SUCCESS) {
+            jit_log("Legacy JIT: vm_allocate failed (%d)", kr);
+            return NULL;
+        }
+        /* Establish executable, writable backing before making the canonical
+         * view RX. vm_remap(copy=FALSE) can then create the existing RW alias.
+         * Never request a new maximum protection to elevate a restricted map.
+         */
+        kr = vm_protect(mach_task_self(), base, size, FALSE, VM_PROT_ALL);
+        if (kr != KERN_SUCCESS) goto failed;
+    }
+    kr = vm_protect(mach_task_self(), base, size, FALSE,
+                    VM_PROT_READ | VM_PROT_EXECUTE);
+    if (kr != KERN_SUCCESS) goto failed;
+
+    /* A successful protection call alone is insufficient: check the effective
+     * permissions and the maximum needed by the later writable remap.
+     */
+    vm_address_t query = base;
+    vm_size_t span = 0;
+    vm_region_basic_info_data_64_t info = {0};
+    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t object = MACH_PORT_NULL;
+    kr = vm_region_64(mach_task_self(), &query, &span, VM_REGION_BASIC_INFO_64,
+                      (vm_region_info_t)&info, &count, &object);
+    if (object != MACH_PORT_NULL) mach_port_deallocate(mach_task_self(), object);
+    if (kr != KERN_SUCCESS || query > base || base - query > span ||
+        size > span - (base - query) ||
+        (info.protection & (VM_PROT_READ | VM_PROT_EXECUTE)) !=
+            (VM_PROT_READ | VM_PROT_EXECUTE) ||
+        (owned && (info.max_protection & VM_PROT_ALL) != VM_PROT_ALL)) {
+        jit_log("Legacy JIT: unusable mapping (kr=%d, prot=%d, max=%d)",
+                kr, info.protection, info.max_protection);
+        goto failed;
+    }
+    sys_icache_invalidate((void *)base, size);
+    return (void *)base;
+
+failed:
+    jit_log("Legacy JIT: preparation failed (%d); enable JIT and retry", kr);
+    if (owned) vm_deallocate(mach_task_self(), base, size);
+    return NULL;
+}
+#endif
