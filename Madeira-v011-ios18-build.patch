diff --git a/scripts/build/setup-llvm-mingw.sh b/scripts/build/setup-llvm-mingw.sh
new file mode 100755
index 0000000..549f8c7
--- /dev/null
+++ b/scripts/build/setup-llvm-mingw.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+set -euo pipefail
+ROOT="${ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
+VERSION=20260421
+NAME="llvm-mingw-${VERSION}-ucrt-macos-universal"
+DEST="$ROOT/toolchains/$NAME"
+URL="https://github.com/mstorsjo/llvm-mingw/releases/download/${VERSION}/${NAME}.tar.xz"
+
+if [[ -x "$DEST/bin/aarch64-w64-mingw32-clang" && -x "$DEST/bin/arm64ec-w64-mingw32-clang" ]]; then
+  echo "llvm-mingw: cached"
+  exit 0
+fi
+
+mkdir -p "$ROOT/toolchains"
+echo "Downloading llvm-mingw $VERSION..."
+curl -fL "$URL" | tar -xJ -C "$ROOT/toolchains"
+[[ -x "$DEST/bin/arm64ec-w64-mingw32-clang" ]] || {
+  echo "ERROR: llvm-mingw archive does not contain arm64ec-w64-mingw32-clang" >&2
+  exit 1
+}
diff --git a/scripts/build/sync-gnutls-libs.sh b/scripts/build/sync-gnutls-libs.sh
new file mode 100755
index 0000000..d1f83f4
--- /dev/null
+++ b/scripts/build/sync-gnutls-libs.sh
@@ -0,0 +1,16 @@
+#!/usr/bin/env bash
+# Copy the freshly built GnuTLS stack into app/Madeira/, where the Xcode
+# project links it. The repo carries previously built copies of these four
+# archives so a plain xcodebuild works, but a clean-clone build must refresh
+# them from the toolchain this script chain just compiled.
+set -euo pipefail
+ROOT="${ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
+SRC="$ROOT/toolchains/gnutls-ios/lib"
+DEST="$ROOT/app/Madeira"
+LIBS=(libgmp.a libnettle.a libhogweed.a libgnutls.a)
+
+for lib in "${LIBS[@]}"; do
+  [[ -f "$SRC/$lib" ]] || { echo "ERROR: missing $SRC/$lib; run build/gnutls-ios/build.sh first" >&2; exit 1; }
+  cp "$SRC/$lib" "$DEST/$lib"
+done
+echo "GnuTLS libraries: synced to $DEST"
diff --git a/tests/host/jit-legacy-test.c b/tests/host/jit-legacy-test.c
new file mode 100644
index 0000000..93b8396
--- /dev/null
+++ b/tests/host/jit-legacy-test.c
@@ -0,0 +1,100 @@
+/* Test the actual legacy allocator with deterministic Mach failures.
+ * cc -std=c11 -Wall -Wextra -Werror tests/host/jit-legacy-test.c -o /tmp/jit-test
+ */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+
+typedef uintptr_t vm_address_t;
+typedef size_t vm_size_t;
+typedef int kern_return_t;
+typedef int mach_port_t;
+typedef unsigned mach_msg_type_number_t;
+typedef int *vm_region_info_t;
+typedef struct { int protection, max_protection; } vm_region_basic_info_data_64_t;
+enum { KERN_SUCCESS = 0, FALSE = 0, VM_FLAGS_ANYWHERE = 1,
+       MACH_PORT_NULL = 0, VM_PROT_READ = 1, VM_PROT_WRITE = 2,
+       VM_PROT_EXECUTE = 4, VM_PROT_ALL = 7, VM_REGION_BASIC_INFO_64 = 9,
+       VM_REGION_BASIC_INFO_COUNT_64 = 2, JIT_PAGE_SIZE = 0x4000 };
+
+static int fail_alloc, fail_protect, fail_query, stripped, no_max_write;
+static int allocations, protections, frees, port_frees, invalidations;
+static size_t mapped_size;
+static vm_address_t mapped_base;
+static bool coalesced;
+static void jit_log(const char *fmt, ...) { (void)fmt; }
+static mach_port_t mach_task_self(void) { return 1; }
+static kern_return_t vm_allocate(mach_port_t t, vm_address_t *a, size_t s, int f) {
+    (void)t; assert(f == VM_FLAGS_ANYWHERE); allocations++;
+    if (fail_alloc) return 3;
+    *a = mapped_base = 0x150000000; mapped_size = s; return 0;
+}
+static kern_return_t vm_protect(mach_port_t t, vm_address_t a, size_t s, int max, int p) {
+    (void)t; assert(a == mapped_base); assert(s == mapped_size); assert(!max);
+    assert(p == VM_PROT_ALL || p == (VM_PROT_READ | VM_PROT_EXECUTE));
+    protections++;
+    return protections == fail_protect ? 2 : 0;
+}
+static kern_return_t vm_region_64(mach_port_t t, vm_address_t *a, vm_size_t *s,
+                                 int flavor, vm_region_info_t out,
+                                 mach_msg_type_number_t *n, mach_port_t *obj) {
+    (void)t; (void)flavor; (void)n;
+    if (fail_query) return 5;
+    vm_region_basic_info_data_64_t *info = (void *)out;
+    info->protection = VM_PROT_READ | (stripped ? 0 : VM_PROT_EXECUTE);
+    info->max_protection = no_max_write ? 5 : VM_PROT_ALL;
+    *s = mapped_size;
+    if (coalesced) { *a -= JIT_PAGE_SIZE; *s += JIT_PAGE_SIZE; }
+    *obj = 42; return 0;
+}
+static kern_return_t mach_port_deallocate(mach_port_t t, mach_port_t p) {
+    (void)t; assert(p == 42); port_frees++; return 0;
+}
+static kern_return_t vm_deallocate(mach_port_t t, vm_address_t a, size_t s) {
+    (void)t; assert(a == mapped_base); assert(s == mapped_size); frees++; return 0;
+}
+static void sys_icache_invalidate(void *a, size_t s) {
+    assert((uintptr_t)a == mapped_base); assert(s == mapped_size); invalidations++;
+}
+#include "../../app/Madeira/JITLegacy.h"
+
+static void reset(void) {
+    fail_alloc = fail_protect = fail_query = stripped = no_max_write = 0;
+    allocations = protections = frees = port_frees = invalidations = 0;
+    coalesced = false; mapped_base = 0x150000000; mapped_size = JIT_PAGE_SIZE;
+}
+int main(void) {
+    reset();
+    assert(jit_legacy_prepare_region(NULL, 1) == (void *)mapped_base);
+    assert(mapped_size == JIT_PAGE_SIZE && protections == 2 && !frees);
+    assert(port_frees == 1 && invalidations == 1);
+    reset(); coalesced = true;
+    assert(jit_legacy_prepare_region(NULL, 0x4001));
+    assert(mapped_size == 0x8000);
+    reset();
+    assert(!jit_legacy_prepare_region(NULL, 0));
+    assert(!jit_legacy_prepare_region(NULL, SIZE_MAX));
+    assert(!jit_legacy_prepare_region((void *)1, 1));
+    assert(!jit_legacy_prepare_region((void *)(UINTPTR_MAX & ~(uintptr_t)0x3fff), 0x4000));
+    assert(!allocations && !protections);
+    reset(); fail_alloc = 1;
+    assert(!jit_legacy_prepare_region(NULL, 1)); assert(!frees && !protections);
+    for (int stage = 1; stage <= 2; stage++) {
+        reset(); fail_protect = stage;
+        assert(!jit_legacy_prepare_region(NULL, 1)); assert(frees == 1);
+    }
+    reset(); fail_query = 1;
+    assert(!jit_legacy_prepare_region(NULL, 1)); assert(frees == 1 && !port_frees);
+    reset(); stripped = 1;
+    assert(!jit_legacy_prepare_region(NULL, 1)); assert(frees == 1 && port_frees == 1);
+    reset(); no_max_write = 1;
+    assert(!jit_legacy_prepare_region(NULL, 1)); assert(frees == 1 && !invalidations);
+    reset();
+    assert(jit_legacy_prepare_region((void *)mapped_base, 1));
+    assert(!allocations && protections == 1 && !frees);
+    reset(); fail_protect = 1;
+    assert(!jit_legacy_prepare_region((void *)mapped_base, 1)); assert(!frees);
+    puts("legacy allocator: all allocation, validation and rollback tests passed");
+}
