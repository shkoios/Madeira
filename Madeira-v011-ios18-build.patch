diff --git a/.github/workflows/ios18-jit.yml b/.github/workflows/ios18-jit.yml
new file mode 100644
index 0000000..2200201
--- /dev/null
+++ b/.github/workflows/ios18-jit.yml
@@ -0,0 +1,49 @@
+name: iOS 18 JIT validation and unsigned app
+on:
+  workflow_dispatch:
+    inputs:
+      build_app:
+        description: 'Attempt app packaging (native archives must already be built)'
+        type: boolean
+        default: false
+permissions:
+  contents: read
+jobs:
+  validate:
+    runs-on: macos-15
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - name: Test legacy VM error handling
+        run: |
+          cc -std=c11 -Wall -Wextra -Werror tests/host/jit-legacy-test.c -o "$RUNNER_TEMP/jit-test"
+          "$RUNNER_TEMP/jit-test"
+      - name: Compile allocator against the iPhone SDK
+        run: |
+          mkdir -p artifacts
+          set -o pipefail
+          xcrun --sdk iphoneos clang -target arm64-apple-ios18.5 \
+            -isysroot "$(xcrun --sdk iphoneos --show-sdk-path)" \
+            -fsyntax-only app/Madeira/JITAllocator.c 2>&1 | tee artifacts/allocator-compile.log
+      - name: Parse changed Swift sources
+        run: |
+          xcrun swiftc -frontend -parse -target arm64-apple-ios18.5 \
+            -sdk "$(xcrun --sdk iphoneos --show-sdk-path)" \
+            app/Madeira/StikJITHelper.swift app/Madeira/ContentView.swift
+      - name: Report native build inputs
+        if: always()
+        run: |
+          python3 build/ci/check-app-inputs.py > artifacts/native-inputs.txt || status=$?
+          cat artifacts/native-inputs.txt
+          echo "Input check exit status: ${status:-0}"
+      - name: Build and package app
+        if: ${{ inputs.build_app }}
+        run: bash build/ci/build-unsigned-ipa.sh
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: madeira-ios18-results
+          path: artifacts/
+          if-no-files-found: warn
